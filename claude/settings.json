{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/old-claudy.sh\" attention 2>/dev/null || true",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/old-claudy.sh\" done 2>/dev/null || true",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/old-claudy.sh\" error 2>/dev/null || true",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  }
}
